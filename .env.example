# Configuración de ESTA instalación. No se versiona, así que sobrevive a los
# git pull: es aquí donde se configura un servidor, nunca en config.ini (que
# viaja con el código y chocaría en cada actualización).
#
# Todo lo que no aparezca aquí toma el valor de fábrica de config.ini, donde
# cada ajuste lleva documentada su variable en la línea «· env».

# Clave de firma de las sesiones. ./docker-up.sh genera una aleatoria al crear
# este fichero. Cambiarla cierra todas las sesiones abiertas.
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Puerto publicado y puerto en el que escucha la app.
PORT=8000


# ─────────────────────────────────────────────────────────────────────────────
# Para exponer el servidor fuera de una LAN de confianza, descomenta esto y
# pon delante un proxy inverso con TLS (Caddy es el de menos trabajo).
#
# Sin TLS, la contraseña y la cookie de sesión viajan en claro por la red:
# cualquiera en el mismo camino las lee. BEHIND_PROXY=true marca las cookies
# como Secure y hace que el servidor lea la IP real del cliente de las
# cabeceras X-Forwarded-*, sin lo cual el bloqueo por intentos fallidos cuenta
# a todo el mundo en el mismo cubo y no sirve de nada.
#
# Actívalo SOLO cuando el proxy esté puesto: con Secure activado y sin TLS, el
# navegador nunca devuelve la cookie y el login se queda en bucle.
#BEHIND_PROXY=true

# Límite por subida y cuota por usuario, en MB (0 = sin límite).
# En un servidor accesible desde fuera, ponles un número.
#MAX_UPLOAD_MB=2048
#USER_QUOTA_MB=20480

# MB que se reservan siempre libres en el volumen. Súbelo si el disco es grande.
#MIN_FREE_DISK_MB=1024

# Longitud mínima de las contraseñas nuevas, e intentos fallidos por IP antes
# de bloquear durante LOGIN_WINDOW_MINUTES.
#MIN_PASSWORD_LENGTH=12
#LOGIN_MAX_ATTEMPTS=10
#LOGIN_WINDOW_MINUTES=15

# Salida de emergencia del HTTPS. El HTTPS se activa desde la interfaz
# (Administración → HTTPS), no desde aquí; esto solo sirve para forzar el
# arranque en HTTP si un certificado roto impide que el servidor arranque.
#HTTPS_ENABLED=false
